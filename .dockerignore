# Only exclude Restreamer runtime/local dirs at the build-context root.
# Do NOT use bare "config/" or "data/" — those also wipe _build/core/config
# and vendor/.../publicsuffix/data during docker build.
.git/
.github/
/config/
/data/
deploy.env
.env
.env.*
*.pem
id_rsa*
id_ed25519*
!*.pub
readme-promo.gif
*.log
.DS_Store
.idea/
.vscode/
/docs/
DEPLOY-DataVault.md
README-FORK.md
_build/restreamer-ui/node_modules/
_build/restreamer-ui/build/
_build/restreamer-ui/coverage/
_build/core/.git/
